<html>
<select id="input">
        <option value ="select">Select a option</option>
        <option value ="campell">Campell</option>
        <option value ="siva">siva</option>\
        <option value ="Thiloth">Thiloth</option>
    </select>
    <button>Get details</button>
    <h1 id="result"></h1>

<script>
        const click = document.querySelector('button')
        click.addEventListener('click', display)
        function display() {
            let output = document.getElementById("result")
            const input = document.getElementById("input")
            const names = input.options[input.selectedIndex].value
            let height, weight
            switch(names){
                case 'Thiloth':
                    height = '6 feet'
                    weight = 85
                    break
                case 'siva': 
                    height = '5.5 feet'
                    weight = 74
                break
                case 'campell': 
                    height = '5.6 feet'
                    weight = 58
                break
            } 
            let text = 'Hi '+names +' your height is ' +height+ ' and your weight is' +weight    
            output.innerHTML = text
            }
    </script>
